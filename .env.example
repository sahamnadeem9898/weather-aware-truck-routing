# Every value is optional: the app runs with no configuration and no API keys.
# Copy to .env and export, or set these in the Render dashboard.

# --- Django ---
# true only for local development; keep false in production.
DJANGO_DEBUG=false
# Optional: a random key is generated per process when unset.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Proxies in front of the app (1 on Render); the client IP is taken from
# X-Forwarded-For accordingly.
NUM_PROXIES=1

# --- Risk ---
# Wind value the risk table is applied to: "speed" (sustained) or "gust".
WIND_FIELD=speed

# --- Third-party services (defaults shown) ---
VALHALLA_URL=https://valhalla1.openstreetmap.de
OSRM_URL=https://router.project-osrm.org
OPEN_METEO_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
NOMINATIM_URL=https://nominatim.openstreetmap.org
